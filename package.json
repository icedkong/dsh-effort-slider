{
  "name": "@local/claude-effort-slider",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Claude Code Desktop-style reasoning effort slider for the DSH composer tool row.",
  "author": "icedkong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icedkong/dsh-effort-slider.git"
  },
  "bugs": {
    "url": "https://github.com/icedkong/dsh-effort-slider/issues"
  },
  "homepage": "https://github.com/icedkong/dsh-effort-slider#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "effort",
    "reasoning",
    "slider",
    "ultracode"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
